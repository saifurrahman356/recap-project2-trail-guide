{% macro trailCard(trail, isAdmin=false) %}
  <article>
    <header>
      <h2>{{ trail.title }}</h2>
      <span class="difficulty-badge difficulty {{ trail.difficulty }}">
        {{ trail.difficulty | capitalize }}
      </span>
    </header>

    <p><strong>Distance:</strong> {{ trail.distanceKm }} km</p>

    <p>
      <strong>Region:</strong>
      {{ trail.regionName }}, {{ trail.regionCountry }}
    </p>

    <footer class="trail-actions">
      <a href="/trails/{{ trail.slug }}" role="button">View trail</a>

      {% if isAdmin %}
        <form action="/admin/trails/{{ trail.id }}/delete" method="POST">
          <button type="submit" class="delete-button">Delete</button>
        </form>

        <form action="/admin/trails/{{ trail.id }}/edit" method="GET">
          <button type="submit">Edit</button>
        </form>
      {% endif %}
    </footer>
  </article>
{% endmacro %}
